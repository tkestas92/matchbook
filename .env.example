POSTGRES_USER=matchbook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=matchbook
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://matchbook:change-me@localhost:5432/matchbook
APP_ENV=local
AGENCY_TIMEZONE=Europe/Vilnius
# Least-privilege DB roles (created/updated by `make roles`)
ETL_DB_PASSWORD=change-me-etl
APP_DB_PASSWORD=change-me-app
AGENT_RO_DB_PASSWORD=change-me-agent-ro
EVAL_RUNNER_DB_PASSWORD=change-me-eval-runner
DEMO_RO_DB_PASSWORD=change-me-demo-ro
# Demo API port on 127.0.0.1 (`make demo-api`, `make demo-up`)
DEMO_API_PORT=8200
# Mock platform APIs (`make mock-apis`)
MOCK_PLATFORMS_PORT=8100
MOCK_PLATFORMS_TOKEN=change-me-mock-platforms
MOCK_PLATFORMS_DELIVERY_DIR=data/generated/delivery
MOCK_PLATFORMS_FAULTS_ENABLED=true
MOCK_PLATFORMS_FAULT_SEED=42
MOCK_PLATFORMS_RATE_429=0.05
MOCK_PLATFORMS_RATE_500=0.02
MOCK_PLATFORMS_RETRY_AFTER_SECONDS=1
# Ingest step (pipelines/ingest.py); authenticates with MOCK_PLATFORMS_TOKEN
INGEST_BASE_URL=http://127.0.0.1:8100
INGEST_PERIOD_START=2026-05-01
INGEST_PERIOD_END=2026-10-31
INGEST_PAGE_SIZE=100
# Airflow (`make airflow-up`, compose profile "airflow"); UI bound to 127.0.0.1 only
AIRFLOW_PORT=8080
AIRFLOW_DB_PASSWORD=change-me-airflow-db
AIRFLOW_JWT_SECRET=change-me-airflow-jwt
AIRFLOW_API_SECRET_KEY=change-me-airflow-api
# LLM access layer (backend/app/llm/, decisions 039 and 040). Free tier: synthetic data only.
# Leave the key empty in this file; put your own spend-limited key in .env only.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Caps in EUR, checked before every call from list prices (see LLM_PRICES_EUR_PER_MTOK in app.config).
LLM_RUN_CAP_EUR=0.20
LLM_MONTHLY_CAP_EUR=1
# Invoice extraction (backend/app/extraction/, decision 042). Below the threshold -> needs_review.
EXTRACTION_CONFIDENCE_THRESHOLD=0.80
EXTRACTION_MAX_PDF_BYTES=5000000
EXTRACTION_MAX_PAGES=5
